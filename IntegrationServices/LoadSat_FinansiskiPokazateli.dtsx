                      name="Expression">#{Package\Data Flow Task\Lookup Sat_FinansiskiPokazateli.Outputs[Lookup Match Output].Columns[Lookup_HashDiff]} == #{Package\Data Flow Task\Compute HashDiff.Outputs[Output 0].Columns[HashDiff]}</property>
