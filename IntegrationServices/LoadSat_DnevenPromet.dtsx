                      name="Expression">[ISNULL](#{Package\Data Flow Task\Lookup Sat_DnevenPromet.Outputs[Lookup Match Output].Columns[Lookup_EndDate]}) &amp;&amp; #{Package\Data Flow Task\Lookup Sat_DnevenPromet.Outputs[Lookup Match Output].Columns[Lookup_HashDiff]} != #{Package\Data Flow Task\Compute HashDiff.Outputs[Output 0].Columns[HashDiff]}</property>
